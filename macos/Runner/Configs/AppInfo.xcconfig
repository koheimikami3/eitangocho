// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
//
// macOS の Dock・Finder・⌘Tab は CFBundleDisplayName ではなく .app のファイル名を
// ラベルにするため、表示名をここに持たせる(iOS は CFBundleDisplayName が効くので
// 事情が違う。docs/design.md)。Info.plist の CFBundleName / CFBundleDisplayName も
// この値を参照し、名前の定義箇所を 1 つにしている。
PRODUCT_NAME = シンプル英単語帳$(APP_DISPLAY_SUFFIX)

// 実行ファイル名は ASCII で固定する。既定では PRODUCT_NAME がそのまま使われるが、
// クラッシュログや配布ツールのログに日本語のプロセス名が出ると扱いにくい。
EXECUTABLE_NAME = eitangocho

// The application's bundle identifier.
// BUNDLE_ID_SUFFIX は Debug/Release の各 xcconfig(プロジェクトレベル)で定義する。
// Debug ビルドのみ ".dev" が付き、サンドボックスコンテナ(= 単語 DB の保存先)が
// ストア配布版と分離される。開発中の dev ビルドが本番データを触らないための対策。
PRODUCT_BUNDLE_IDENTIFIER = com.kohei.mikami.eitangocho$(BUNDLE_ID_SUFFIX)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.kohei.mikami. All rights reserved.
